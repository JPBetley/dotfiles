#!/bin/bash
#
# Install: bring this machine in line with the repo. Safe to run any number of
# times. See CONTEXT.md for vocabulary and README.md for usage.

set -euo pipefail

usage() {
	cat <<'USAGE'
Usage: ./install [step...] [--profile <name>] [--dry-run]

Steps:
  provision  Install the Command Line Tools, Homebrew and the Brewfile's
             packages (never uninstalls; unlisted packages are reported)
  link       Wire repo files into $HOME (conflicts are moved to a Backup)
  defaults   Apply macOS defaults (opt-in only: needs sudo, wipes the Dock,
             sets the timezone, changes hibernation; none of it can be undone)

With no step, every default step runs: provision, then link. defaults never runs unless named.

Options:
  --profile <name>  Add a Profile (a folder under profiles/, e.g. work or
                    personal) on top of the base. Saved in ~/.dotfiles-profile
                    and reused by later runs; "none" clears it
  --dry-run         Print what would happen and change nothing (a --profile
                    is shown but not saved)
  -h, --help        Show this help
USAGE
}

DEFAULT_STEPS="provision link"
ALL_STEPS="provision link defaults"

DRY_RUN=0
steps=""
profile_arg=""
profile_given=0
while [ $# -gt 0 ]; do
	case "$1" in
		--dry-run) DRY_RUN=1 ;;
		--profile)
			[ $# -ge 2 ] || { echo "install: --profile needs a name" >&2; usage >&2; exit 2; }
			profile_arg="$2"
			profile_given=1
			shift
			;;
		--profile=*) profile_arg="${1#--profile=}"; profile_given=1 ;;
		-h | --help) usage; exit 0 ;;
		*)
			case " $ALL_STEPS " in
				*" $1 "*) steps="$steps $1" ;;
				*) echo "install: unknown step '$1'" >&2; usage >&2; exit 2 ;;
			esac
			;;
	esac
	shift
done
steps="${steps:-$DEFAULT_STEPS}"

DOTFILES="$HOME/.dotfiles"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

if [ ! -d "$DOTFILES" ] || [ "$(cd "$DOTFILES" && pwd -P)" != "$here" ]; then
	echo "install: this repo must live at ~/.dotfiles (it is at $here)." >&2
	echo "Clone it there, or symlink ~/.dotfiles to it, then run ~/.dotfiles/install." >&2
	exit 1
fi

BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
changes=0
# Brewfiles whose `brew bundle` failed; Install carries on and exits non-zero.
failed_brewfiles=""

# Show a $HOME path as ~/...
pretty() {
	case "$1" in
		"$HOME"/*) echo "~/${1#"$HOME"/}" ;;
		*) echo "$1" ;;
	esac
}

# Report a planned change, and make it unless this is a dry run.
# Usage: act "<message>" command [args...]
act() {
	local message="$1"
	shift
	changes=$((changes + 1))
	echo "$message"
	[ "$DRY_RUN" -eq 1 ] || "$@"
}

# --- Profile -----------------------------------------------------------------

# A Profile is an optional named layer (profiles/<name>/) on top of the base.
PROFILE_FILE="$HOME/.dotfiles-profile"

# Print the profiles that exist, comma-separated.
list_profiles() {
	local dir names=""
	for dir in "$DOTFILES"/profiles/*/; do
		[ -d "$dir" ] || continue
		dir="${dir%/}"
		names="${names:+$names, }${dir##*/}"
	done
	echo "$names"
}

is_profile() {
	[ -n "$1" ] && [ "${1#*/}" = "$1" ] && [ -d "$DOTFILES/profiles/$1" ] && [ "${1#.}" = "$1" ]
}

save_profile() {
	echo "$1" > "$PROFILE_FILE"
}

PROFILE=""
saved_profile="$(cat "$PROFILE_FILE" 2> /dev/null || true)"
if [ "$profile_given" -eq 1 ]; then
	[ "$profile_arg" = none ] || PROFILE="$profile_arg"
	if [ "$profile_arg" != none ] && ! is_profile "$PROFILE"; then
		echo "install: unknown profile '$PROFILE'; profiles: $(list_profiles) (or none)" >&2
		exit 2
	fi
elif [ -n "$saved_profile" ]; then
	PROFILE="$saved_profile"
	if ! is_profile "$PROFILE"; then
		echo "install: $(pretty "$PROFILE_FILE") names unknown profile '$PROFILE'; profiles: $(list_profiles)" >&2
		echo "Rerun with --profile <name>, or --profile none to clear it." >&2
		exit 2
	fi
fi

# Save a --profile choice for later runs.
remember_profile() {
	[ "$profile_given" -eq 1 ] && [ "$PROFILE" != "$saved_profile" ] || return 0
	if [ -n "$PROFILE" ]; then
		act "profile $PROFILE (saved in $(pretty "$PROFILE_FILE"))" save_profile "$PROFILE"
	else
		act "profile none (removed $(pretty "$PROFILE_FILE"))" rm -f "$PROFILE_FILE"
	fi
}

# --- Provision ---------------------------------------------------------------

BREWFILE="$DOTFILES/Brewfile"
# The base Brewfile, then the Profile's.
BREWFILES=("$BREWFILE")
[ -z "$PROFILE" ] || [ ! -f "$DOTFILES/profiles/$PROFILE/Brewfile" ] ||
	BREWFILES+=("$DOTFILES/profiles/$PROFILE/Brewfile")

# Where Homebrew lives when it isn't on the PATH (Apple silicon, then Intel).
BREW_PATHS="${DOTFILES_BREW_PATHS:-/opt/homebrew/bin/brew /usr/local/bin/brew}"

# Print the brew executable, or fail if Homebrew isn't installed.
find_brew() {
	local brew
	for brew in $(command -v brew) $BREW_PATHS; do
		[ -x "$brew" ] && { echo "$brew"; return; }
	done
	return 1
}

install_homebrew() {
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

step_provision() {
	local brew brewfile missing
	# brew bundle install uninstalls unlisted packages when these are set.
	unset HOMEBREW_BUNDLE_INSTALL_CLEANUP HOMEBREW_BUNDLE_FORCE_INSTALL_CLEANUP
	if ! xcode-select -p > /dev/null 2>&1; then
		act "xcode   install Xcode Command Line Tools" xcode-select --install
		if [ "$DRY_RUN" -eq 0 ]; then
			echo "install: finish the Command Line Tools installer, then rerun ./install." >&2
			exit 1
		fi
	fi
	if ! brew="$(find_brew)"; then
		act "brew    install Homebrew" install_homebrew
		if [ "$DRY_RUN" -eq 1 ]; then
			for brewfile in "${BREWFILES[@]}"; do
				echo "brew    bundle $(pretty "$brewfile")"
			done
			return
		fi
		brew="$(find_brew)"
	fi
	eval "$("$brew" shellenv)"
	for brewfile in "${BREWFILES[@]}"; do
		if ! missing="$("$brew" bundle check --verbose --no-upgrade --file="$brewfile" 2>&1)"; then
			act "brew    bundle $(pretty "$brewfile")
$(sed -n 's/^→ \(.*\) needs to be installed.*/      + \1/p' <<< "$missing")" \
				"$brew" bundle install --no-upgrade --file="$brewfile" ||
				failed_brewfiles="$failed_brewfiles $(pretty "$brewfile")"
		fi
	done
	report_unlisted "$brew"
}

# Print what is installed but in neither the base nor the Profile's Brewfile.
# Provision never removes it.
report_unlisted() {
	local extras all where="the Brewfile"
	all="$(mktemp)"
	cat "${BREWFILES[@]}" > "$all"
	extras="$("$1" bundle cleanup --file="$all")" && { rm -f "$all"; return; }
	rm -f "$all"
	[ "${#BREWFILES[@]}" -eq 1 ] || where="the Brewfile or the $PROFILE Profile's"
	echo "Installed but not in $where (nothing was uninstalled; add to keep):"
	awk '
		/^Would uninstall .*:$/ { sub(/^Would uninstall /, ""); group = $0; next }
		/^Would untap:$/ { group = "taps:"; next }
		/^(Would .*:|Run `brew bundle cleanup.*)$/ { group = ""; next }
		group { list[group] = list[group] (list[group] ? ", " : " ") $0; if (!(group in seen)) order[++n] = group; seen[group] }
		END { for (i = 1; i <= n; i++) print "  " order[i] list[order[i]] }' <<< "$extras"
}

# --- Link --------------------------------------------------------------------

# Link manifest: one "repo path -> $HOME path" pair per line.
LINKS="
shell/.vimrc      .vimrc
shell/.vim        .vim
shell/.tmux.conf  .tmux.conf
shell/starship.toml  .config/starship.toml
"

move() {
	mkdir -p "$(dirname "$2")"
	mv "$1" "$2"
}

# Move a conflicting $HOME path into this run's Backup.
backup() {
	local dest="$1" saved="$BACKUP_DIR/${1#"$HOME"/}"
	act "backup  $(pretty "$dest") -> $(pretty "$saved")" move "$dest" "$saved"
}

link_one() {
	local src="$DOTFILES/$1" dest="$HOME/$2"
	if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
		return
	fi
	if [ -e "$dest" ] || [ -L "$dest" ]; then
		backup "$dest"
	fi
	act "link    $(pretty "$dest") -> $(pretty "$src")" symlink "$src" "$dest"
}

symlink() {
	mkdir -p "$(dirname "$2")"
	ln -s "$1" "$2"
}

# Retired $HOME paths from older setups: moved to a Backup if still present.
RETIRED="
.global-gitignore
.gitignore
"

# Print the settings in a git config file that the repo's git/config doesn't
# define: the machine-local part worth keeping when adopting it as a Stub.
gitconfig_machine_local() {
	local kept entry key value
	kept="$(mktemp)"
	git config -f "$1" --null --list | while IFS= read -r -d '' entry; do
		key="${entry%%$'\n'*}"
		value="true"
		[ "$key" = "$entry" ] || value="${entry#*$'\n'}"
		git config -f "$DOTFILES/git/config" --get-all "$key" > /dev/null ||
			git config -f "$kept" --add "$key" "$value"
	done
	cat "$kept"
	rm -f "$kept"
}

step_link() {
	local src dest
	while read -r src dest; do
		[ -n "$src" ] || continue
		link_one "$src" "$dest"
	done <<< "$LINKS"
	for dest in $RETIRED; do
		if [ -e "$HOME/$dest" ] || [ -L "$HOME/$dest" ]; then
			backup "$HOME/$dest"
		fi
	done
	link_stubs
}

# Stubs: machine-owned files that other tools write to (see ADR 0001). Link
# only ensures each holds exactly one Managed line, ending in the marker.
MARKER="# dotfiles:link"

# Usage: stub <$HOME path> <line to manage, without the marker> [once] [adopt]
# Lines containing the optional "once" text are de-duplicated, keeping the first.
# The optional "adopt" command runs once, on a file with no Managed line yet: it
# gets the file's path and prints the part to keep; the original goes to a Backup.
stub() {
	local dest="$HOME/$1" managed="$2 $MARKER" once="${3:-}" adopt="${4:-}"
	local before new src
	before="$(mktemp)"
	new="$(mktemp)"
	# A symlinked (or non-file) Stub would be written through, so set it aside.
	if [ -L "$dest" ] || { [ -e "$dest" ] && [ ! -f "$dest" ]; }; then
		backup "$dest"
	elif [ -f "$dest" ]; then
		cp "$dest" "$before"
	fi
	src="$before"
	if [ -n "$adopt" ] && [ -s "$before" ] && ! grep -qF "$MARKER" "$before"; then
		src="$(mktemp)"
		"$adopt" "$before" > "$src"
		cmp -s "$src" "$before" || backup "$dest"
	fi
	awk -v managed="$managed" -v marker="$MARKER" -v once="$once" '
		{ line[NR] = $0 }
		END {
			# The Managed line goes where the first marked line is; with
			# none, adopt an unmarked line that sources the repo.
			for (i = 1; i <= NR; i++) if (index(line[i], marker)) { at = i; break }
			if (!at) for (i = 1; i <= NR; i++)
				if (line[i] ~ /^[ \t]*(source|\.)[ \t].*\.dotfiles\//) { at = i; break }
			if (!at) print managed
			for (i = 1; i <= NR; i++) {
				if (i == at) print managed
				else if (index(line[i], marker)) continue
				else if (once != "" && index(line[i], once) && seen++) continue
				else print line[i]
			}
		}' "$src" > "$new"
	if [ ! -f "$dest" ] || [ -L "$dest" ] || ! cmp -s "$new" "$before"; then
		act "stub    $(pretty "$dest")" cp "$new" "$dest"
		diff "$before" "$new" | sed -n -e 's/^< /      - /p' -e 's/^> /      + /p' || true
	fi
	rm -f "$before" "$new"
	[ "$src" = "$before" ] || rm -f "$src"
}

link_stubs() {
	stub .zshrc 'source "$HOME/.dotfiles/shell/.zshrc"'
	stub .zprofile 'source "$HOME/.dotfiles/shell/.zprofile"' 'brew shellenv'
	stub .gitconfig '[include] path = ~/.dotfiles/git/config' '' gitconfig_machine_local
}

# --- Defaults ----------------------------------------------------------------

step_defaults() {
	act "defaults  macos/set-defaults.sh" "$DOTFILES/macos/set-defaults.sh"
}

# --- main --------------------------------------------------------------------

[ "$DRY_RUN" -eq 0 ] || echo "Dry run: nothing will be changed."
remember_profile
for step in $steps; do
	"step_$step"
done
[ "$changes" -gt 0 ] || echo "Nothing to do."
[ -n "$PROFILE" ] ||
	echo "Note: no Profile, so only the base was applied; add one with ./install --profile <name> ($(list_profiles))."
[ -d "$HOME/.dotfiles-custom" ] ||
	echo "Note: no ~/.dotfiles-custom; create it (e.g. ~/.dotfiles-custom/shell/.aliases) for personal config you keep out of git."
if [ -n "$failed_brewfiles" ]; then
	echo "install: brew bundle failed for:$failed_brewfiles (see above); fix it, then rerun ./install." >&2
	exit 1
fi
